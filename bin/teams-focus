#!/usr/bin/env python3
"""Focus the running Teams window, or start Teams if there is none."""

import json
import subprocess

APP_ID = "teams-for-linux"

raw = subprocess.run(["niri", "msg", "--json", "windows"],
                     capture_output=True, text=True).stdout
windows = json.loads(raw) if raw.strip() else []
match = next((w for w in windows if w.get("app_id") == APP_ID), None)

if match:
    subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(match["id"])],
                   capture_output=True)
else:
    subprocess.Popen([APP_ID], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
