// ────────────── Named Workspaces ──────────────
// Declaration order = position. Names "1".."3" keep Mod+1/2/3 working.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout#workspaces

    workspace "1" { open-on-output "HDMI-A-1"; }
    workspace "2" { open-on-output "HDMI-A-1"; }
    workspace "3" { open-on-output "HDMI-A-1"; }
